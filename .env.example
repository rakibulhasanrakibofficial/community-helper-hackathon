# Optional local configuration
PORT=5000
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e2b

# Optional local VoiceStudio service (same computer as Community Helper server)
# No model downloads are triggered by Community Helper.
VOICESTUDIO_URL=http://127.0.0.1:3900

# Optional remote VoiceStudio bridge for a deployed Render backend.
# Use only with a Cloudflare Tunnel protected by a Cloudflare Access service-token policy.
# Set VOICESTUDIO_URL to the exact HTTPS hostname; never expose port 3900 directly.
# Keep the service-token values only in Render Environment settings, never commit real values.
VOICESTUDIO_ALLOWED_HOST=
VOICESTUDIO_ACCESS_CLIENT_ID=
VOICESTUDIO_ACCESS_CLIENT_SECRET=
